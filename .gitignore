# data is never committed
data/**
!data/MANIFEST.md
!data/.gitkeep

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.benchmarks/
.coverage
htmlcov/

# outputs — figures and rendered pages are regenerated, never committed
outputs/
*.tif
*.tiff
!tests/fixtures/**/*.tif

# notebooks
.ipynb_checkpoints/

# os / editors
.DS_Store
.idea/
.vscode/

# Deployment credentials. compose reads this for POSTGRES_USER and
# POSTGRES_PASSWORD, and the application reads it for FLOODLINE_ settings.
# .env.example is the committed template; this file never is.
.env
