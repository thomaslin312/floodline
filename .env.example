# floodline deployment settings.
#
# GENERATED by `floodline env-template --write`. Do not edit by hand: the
# descriptions and defaults below come from `floodline.settings.Settings`, and
# a test fails if this file and that model disagree. To change a comment here,
# change the field's description there.
#
# Copy to .env and set what your deployment needs. Almost every value below is
# the default, so you only need lines for what you are actually overriding.
#
# The exception is the compose credentials block immediately below. Those have
# no defaults on purpose: `docker compose up` fails naming the missing variable
# rather than starting a database on a password published in a git repository.
#
# Model parameters are NOT here. Manning's roughness, accumulation thresholds,
# curve families and the rest describe what the model is rather than where it
# runs, so they live in core/config.py and are versioned with the code that
# reads them. Changing one changes the answer; changing a setting below does not.

# --------------------------------------------------------------------------
# Compose credentials - REQUIRED, no defaults
# --------------------------------------------------------------------------
# Read by compose, not by the application: they initialise the db service and
# are interpolated into the API's FLOODLINE_DATABASE_URL. Generate the password
# rather than typing one, e.g. `openssl rand -base64 24`.
#
# POSTGRES_PASSWORD initialises a *new* data directory and nothing else. Changing
# it here does not change the password of a database that already exists - the
# api then fails authentication against a db that is otherwise healthy. To rotate
# it on a running stack, ALTER the role; to start over, `docker compose down -v`,
# which deletes the data.
POSTGRES_USER=floodline
POSTGRES_PASSWORD=
POSTGRES_DB=floodline

# --------------------------------------------------------------------------
# Compose: the public address
# --------------------------------------------------------------------------
# Unprefixed, like POSTGRES_*, because the FLOODLINE_ prefix belongs to the
# application's settings model: anything carrying it should be a field on
# `floodline.settings.Settings`, and a test enforces that. These are read by
# compose.
#
# The hostname Caddy serves and gets a Let's Encrypt certificate for. It must
# already resolve to this machine, and ports 80 and 443 must reach it, before
# the first request - that is how the certificate is issued.
#
# Left unset this is `localhost`, served from Caddy's own internal CA: right
# for a check on the machine itself, and a browser warning anywhere else.
PUBLIC_DOMAIN=
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
ACME_EMAIL=


# --------------------------------------------------------------------------
# Where things live
# --------------------------------------------------------------------------
# Downloaded source data. Never committed; deletable and refetched.
FLOODLINE_DATA_RAW=data/raw

FLOODLINE_DATA_INTERIM=data/interim

FLOODLINE_DATA_PROCESSED=data/processed

FLOODLINE_OUTPUTS=outputs

# Fetched artefacts that are expensive to re-download: the structure
# inventory, curve libraries, the population raster.
FLOODLINE_CACHE_DIR=data/cache

# Computed watershed bundles the service serves. Evicted to
# bundle_cache_budget_mb.
FLOODLINE_BUNDLE_CACHE_DIR=outputs/cache

# Cached terrain results, keyed by watershed and parameter hash. The
# expensive, request-independent half of the pipeline.
FLOODLINE_HAND_CACHE_DIR=outputs/hand

# Published values that `floodline reproduce` regenerates and checks.
FLOODLINE_RESULTS_PATH=docs/RESULTS.json

# Cached national high-water marks, the ground truth for validation.
FLOODLINE_MARKS_PATH=data/raw/validation/high_water_marks_national.json


# --------------------------------------------------------------------------
# Upstream services (public, keyless)
# --------------------------------------------------------------------------
# Every one of these is a public, keyless endpoint. They are settings rather
# than constants because agencies move them: three changed host or format
# during development, and each time it was a code change.
# USGS National Map product search, for 3DEP elevation tiles.
FLOODLINE_TNM_PRODUCTS_URL=https://tnmaccess.nationalmap.gov/api/v1/products

# USGS NWIS instantaneous values.
FLOODLINE_NWIS_INSTANTANEOUS_URL=https://waterservices.usgs.gov/nwis/iv/

# USGS NWIS site service, for gauges within a bounding box.
FLOODLINE_NWIS_SITE_URL=https://waterservices.usgs.gov/nwis/site/

# USGS annual peak-flow series, including peak gage height.
FLOODLINE_NWIS_PEAK_URL=https://nwis.waterdata.usgs.gov/nwis/peak

# USGS Short-Term Network high-water marks, filtered.
FLOODLINE_STN_HWM_URL=https://stn.wim.usgs.gov/STNServices/HWMs/FilteredHWMs.json

# Every high-water mark the STN holds. About 26 MB; fetched once.
FLOODLINE_STN_ALL_HWM_URL=https://stn.wim.usgs.gov/STNServices/HWMs.json

# Named flood events, joined to marks so a mark says which flood.
FLOODLINE_STN_EVENTS_URL=https://stn.wim.usgs.gov/STNServices/Events.json

# USGS Watershed Boundary Dataset, for hydrologic unit polygons.
FLOODLINE_WBD_URL=https://hydro.nationalmap.gov/arcgis/rest/services/wbd/MapServer

# USACE National Structure Inventory. POST a polygon, get structures.
FLOODLINE_NSI_URL=https://nsi.sec.usace.army.mil/nsiapi/structures

# USACE depth-damage curve library, MIT licensed.
FLOODLINE_USACE_CURVES_URL=https://raw.githubusercontent.com/USACE/go-consequences/main/structures/occtypes.json

# OpenFEMA, for NFIP claims and Individual Assistance.
FLOODLINE_OPENFEMA_URL=https://www.fema.gov/api/open/v2

# Census TIGERweb, for ZIP and block-group geography.
FLOODLINE_TIGERWEB_URL=https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb

# Census geocoder, for turning an address into a coordinate.
FLOODLINE_CENSUS_GEOCODE_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress

# Microsoft Planetary Computer STAC, for Sentinel-1 scenes.
FLOODLINE_PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1/search

# WorldPop constrained population. Advertises range support and ignores it, so
# this is downloaded once rather than windowed.
FLOODLINE_WORLDPOP_URL=https://data.worldpop.org/GIS/Population/Global_2000_2020_Constrained/2020/BSGM/USA/usa_ppp_2020_UNadj_constrained.tif

# JRC Global Human Settlement population, the WorldPop alternative.
FLOODLINE_GHSL_URL=https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_POP_GLOBE_R2023A/


# --------------------------------------------------------------------------
# How to talk to them
# --------------------------------------------------------------------------
# Sent on every request. Agencies block anonymous bulk readers, and
# identifying the client is the difference between being throttled and
# blocked.
FLOODLINE_USER_AGENT=floodline/0.1 (+https://github.com/thomaslin312/floodline)

# Attempts per request before giving up.
FLOODLINE_HTTP_MAX_ATTEMPTS=4

# Base for exponential backoff between attempts.
FLOODLINE_HTTP_BACKOFF_SECONDS=2.0

FLOODLINE_HTTP_CONNECT_TIMEOUT_S=30.0

# Generous: some DEM tiles are hundreds of MB.
FLOODLINE_HTTP_READ_TIMEOUT_S=300.0


# --------------------------------------------------------------------------
# Service limits
# --------------------------------------------------------------------------
# Largest grid the service will attempt. Depression filling is global, so the
# whole watershed must be resident in memory.
FLOODLINE_MAX_CELLS=40000000

# Watershed computations in flight at once. Guards this machine.
FLOODLINE_MAX_CONCURRENT=2

# Per-client request budget. Guards everyone upstream.
FLOODLINE_RATE_PER_MINUTE=30.0

# Requests a client may make back to back.
FLOODLINE_RATE_BURST=10

# Disk the served bundles may occupy before eviction.
FLOODLINE_BUNDLE_CACHE_BUDGET_MB=2048.0

# Disk the cached terrain artefacts may occupy before the oldest are evicted.
# Roughly 4.5 MB per watershed at 30 m and nine times that at 10 m, and this
# service offers every watershed in the country, so unbounded means a disk
# that fills at whatever rate visitors click.
FLOODLINE_TERRAIN_CACHE_BUDGET_MB=8192.0

# Disk the cached structure inventory may occupy before the oldest are
# evicted. About 16 MB per watershed. Evicting one costs a refetch from NSI,
# which is minutes, so this wants to be generous.
FLOODLINE_INVENTORY_CACHE_BUDGET_MB=8192.0

# Ceiling on one synchronous /scenario request. A cache miss must fetch a DEM,
# which is the slow part; past this the caller is told to retry rather than
# left holding a socket open.
FLOODLINE_REQUEST_TIMEOUT_S=180.0


# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# compose interpolates POSTGRES_USER and POSTGRES_PASSWORD into the URL below,
# so setting those is usually enough and this line is for a database compose
# does not run.
# PostGIS connection string. The compose stack sets this to the db service; a
# developer without one can leave it and the API will report itself not ready
# rather than failing at the first query.
FLOODLINE_DATABASE_URL=postgresql+psycopg://floodline:floodline@localhost:5432/floodline

# Connections held open. Small: requests are seconds, not ms.
FLOODLINE_DB_POOL_SIZE=5

# Refuse quickly when the database is down. A readiness probe that hangs is
# worse than one that fails.
FLOODLINE_DB_CONNECT_TIMEOUT_S=5

# Where the structure intersection runs. PostGIS is the deployed path: an
# index scan over a GiST index rather than a quarter of a million rows held
# resident to discard most. `geopandas` keeps the in-process predicate
# runnable, which is what makes the equivalence between them a measurement
# rather than a citation. A deployment with no database falls back to it and
# says so in the run's gaps.
FLOODLINE_BUILDING_INDEX=postgis
